{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-customization.dev/schema/customization-v1.json",
  "title": "Managed skill customization descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "name",
    "license",
    "entrypoint",
    "customization",
    "dependencies",
    "owned_payload",
    "source",
    "activation"
  ],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonMachinePathString" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/stableId" },
    "type": { "$ref": "#/$defs/customizationType" },
    "name": { "$ref": "#/$defs/skillName" },
    "license": { "$ref": "#/$defs/license" },
    "entrypoint": { "$ref": "#/$defs/relativePath" },
    "customization": { "$ref": "#/$defs/relativePath" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/skillName" }
    },
    "owned_payload": { "$ref": "#/$defs/ownedPayload" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/repositorySource" },
        { "$ref": "#/$defs/localSource" },
        { "$ref": "#/$defs/customizationSource" }
      ]
    },
    "activation": { "$ref": "#/$defs/activation" },
    "fork": { "$ref": "#/$defs/fork" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "fork" } },
        "required": ["type"]
      },
      "then": { "required": ["fork"] },
      "else": { "not": { "required": ["fork"] } }
    },
    {
      "if": {
        "properties": {
          "activation": {
            "properties": { "mode": { "const": "replace" } },
            "required": ["mode"]
          }
        },
        "required": ["activation"]
      },
      "then": { "properties": { "activation": { "required": ["precedence"] } } }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "fork" },
          "source": {
            "properties": {
              "kind": { "const": "customization" },
              "type": { "const": "semantic-overlay" }
            },
            "required": ["kind", "type"]
          }
        },
        "required": ["type", "source"]
      },
      "then": { "properties": { "fork": { "required": ["materialization"] } } }
    }
  ],
  "$defs": {
    "nonMachinePathString": {
      "type": "string",
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^\\\\" } },
        { "not": { "pattern": "^[A-Za-z]:[\\\\/]" } },
        { "not": { "pattern": "^[Ff][Ii][Ll][Ee]:" } },
        { "not": { "pattern": "^~[^\\\\/]*(?:[\\\\/]|$)" } }
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^(?![Ff][Ii][Ll][Ee]:)(?![A-Za-z]:[\\\\/])[a-z][a-z0-9+.-]*:[^\\s]+$"
    },
    "skillName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 63
    },
    "customizationType": { "enum": ["semantic-overlay", "fork"] },
    "license": {
      "$ref": "#/$defs/nonMachinePathString",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "ownedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_fingerprint"],
      "properties": {
        "reviewed_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "repositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "kind",
        "repository",
        "upstream_path",
        "license",
        "effective_fingerprint",
        "review"
      ],
      "properties": {
        "skill_name": { "$ref": "#/$defs/skillName" },
        "kind": { "const": "repository" },
        "repository": {
          "type": "string",
          "pattern": "^https://(?![^/\\s]*@)[^/\\s]+/[^?#\\s]+$"
        },
        "upstream_path": { "$ref": "#/$defs/relativePath" },
        "license": { "$ref": "#/$defs/license" },
        "effective_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision"],
          "properties": {
            "revision": {
              "$ref": "#/$defs/nonMachinePathString",
              "minLength": 1
            }
          }
        }
      }
    },
    "localSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "kind",
        "identity",
        "license",
        "effective_fingerprint"
      ],
      "properties": {
        "skill_name": { "$ref": "#/$defs/skillName" },
        "kind": { "const": "local" },
        "identity": {
          "type": "string",
          "pattern": "^local:sha256:[0-9a-f]{64}$"
        },
        "license": { "$ref": "#/$defs/license" },
        "effective_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "customizationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "kind",
        "id",
        "type",
        "license",
        "effective_fingerprint"
      ],
      "properties": {
        "skill_name": { "$ref": "#/$defs/skillName" },
        "kind": { "const": "customization" },
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "$ref": "#/$defs/customizationType" },
        "license": { "$ref": "#/$defs/license" },
        "effective_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["coexist", "replace"] },
        "precedence": { "const": "customization-first" }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_effective_fingerprint",
        "snapshot_fingerprint",
        "reviewed_at",
        "evidence"
      ],
      "properties": {
        "source_effective_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "snapshot_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewed_at": {
          "$ref": "#/$defs/nonMachinePathString",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/nonMachinePathString",
          "minLength": 1
        }
      }
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "diff",
        "snapshot_fingerprint",
        "diff_fingerprint"
      ],
      "properties": {
        "snapshot": { "$ref": "#/$defs/relativePath" },
        "diff": { "$ref": "#/$defs/relativePath" },
        "snapshot_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "diff_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "materialization": { "$ref": "#/$defs/materialization" }
      }
    }
  }
}
